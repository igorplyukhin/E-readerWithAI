<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LibApp" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Основной шрифт приложения -->
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <!-- Стиль текста для BottomNavigationView -->
        <item name="bottomNavigationStyle">@style/BottomNavigationStyle</item>
    </style>

    <style name="BottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>
    </style>

    <style name="BottomNavText" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>






</resources>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LibApp" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Основной шрифт приложения -->
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <!-- Стиль текста для BottomNavigationView -->
        <item name="bottomNavigationStyle">@style/BottomNavigationStyle</item>
    </style>

    <style name="BottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>
    </style>

    <style name="BottomNavText" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="SquareButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">4dp</item> <!-- Углы почти квадратные -->
    </style>

    <style name="CustomProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <!-- Цвет движущейся полосы -->
        <item name="android:progressDrawable">@drawable/progress_bar</item>
    </style>

    <style name="CustomButton" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">7dp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="CustomEditText" parent="Widget.AppCompat.EditText">
        <!-- Убираем стандартные отступы -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- Устанавливаем текст -->
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>

        <!-- Убираем внутренние отступы -->
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <!-- Устанавливаем закругленные углы -->
        <item name="android:background">@drawable/rounded_edittext</item>
    </style>

    <style name="SliderStyle" parent="Widget.MaterialComponents.Slider">
        <!-- Цвет активной части трека -->
        <item name="trackColorActive">@color/slider_active</item>
        <!-- Цвет неактивной части трека -->
        <item name="trackColorInactive">@color/slider_inactive</item>
        <!-- Цвет точек -->
        <item name="tickColor">@color/slider_tick</item>
        <!-- Цвет точек после текущего значения -->
        <item name="tickColorInactive">@color/slider_inactive</item>
        <!-- Размер точки (гало) -->
        <item name="haloColor">@color/slider_halo</item>
        <!-- Размер гало -->
        <item name="haloRadius">8dp</item>
        <!-- Цвет ползунка -->
        <item name="thumbColor">@color/slider_thumb</item>
        <!-- Размер ползунка -->
        <item name="thumbRadius">12dp</item>
        <!-- Высота трека -->
        <item name="trackHeight">4dp</item>
        <item name="android:minHeight">0dp</item> <!-- Минимальная высота -->
        <item name="android:paddingTop">0dp</item> <!-- Убираем отступ сверху -->
        <item name="android:paddingBottom">0dp</item> <!-- Убираем отступ снизу -->
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <!-- Прозрачный фон -->
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <!-- Убираем цветной фон -->
        <item name="android:background">@android:color/transparent</item>
        <!-- Настраиваем закруглённые углы -->
        <item name="shapeAppearanceOverlay">@style/BottomSheetShape</item>
    </style>

    <style name="BottomSheetShape" parent="ShapeAppearanceOverlay.MaterialComponents.BottomSheet">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>




</resources>
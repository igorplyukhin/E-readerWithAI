<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Состояние кнопки при нажатии -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D6D6D6" /> <!-- Светло-серый фон при нажатии -->
            <stroke android:width="2dp" android:color="#000000" /> <!-- Чёрная рамка -->
            <corners android:radius="0dp" /> <!-- Прямоугольные углы -->
        </shape>
    </item>

    <!-- Состояние кнопки по умолчанию -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- Белый фон -->
            <stroke android:width="2dp" android:color="#000000" /> <!-- Чёрная рамка -->
            <corners android:radius="0dp" /> <!-- Прямоугольные углы -->
        </shape>
    </item>

</selector>
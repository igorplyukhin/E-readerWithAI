<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101317">

    <!-- Заголовок "Мои книги" -->
    <TextView
            android:id="@+id/tvMyBooks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Мои книги"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnMore"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="50dp" />

    <!-- Кнопка "..." -->
    <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/more"

            android:padding="8dp"
            app:layout_constraintTop_toTopOf="@+id/tvMyBooks"
            app:layout_constraintBottom_toBottomOf="@+id/tvMyBooks"
            app:layout_constraintStart_toEndOf="@+id/tvMyBooks" />

    <!-- Кнопка "+" -->
    <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/add"
            app:layout_constraintTop_toTopOf="@+id/btnMore"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnMore"
            app:layout_constraintStart_toEndOf="@+id/btnMore" />

    <!-- RecyclerView для отображения списка книг -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBooks"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/adjustable_btn"
            app:layout_constraintBottom_toTopOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_marginTop="8dp" />

    <!-- Разделительная линия -->
    <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- BottomNavigationView для нижней навигации -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav_menu"
            app:itemTextColor="@color/bottom_nav_text_color"
            app:itemIconTint="@color/bottom_nav_text_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="#101317"
            app:labelVisibilityMode="labeled"
            android:paddingBottom="5dp"
            app:itemPaddingBottom="5dp"
            app:itemPaddingTop="8dp" />

    <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            app:srcCompat="@drawable/old_button"
            android:id="@+id/old_btn"
            app:layout_constraintTop_toTopOf="@+id/adjustable_btn"
            app:layout_constraintBottom_toBottomOf="@+id/adjustable_btn"
            app:layout_constraintStart_toEndOf="@+id/adjustable_btn"
            android:layout_marginStart="10dp" />

    <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            app:srcCompat="@drawable/adjustable_button"
            android:id="@+id/adjustable_btn"
            app:layout_constraintTop_toBottomOf="@+id/tvMyBooks"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            />

    <!-- Индикатор загрузки -->
    <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>